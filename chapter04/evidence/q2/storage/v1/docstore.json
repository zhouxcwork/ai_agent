{"docstore/data": {"e92897d1abc922dcc37ce355c9ee021a06b0fb3c15b50acb773ce866fa69d5c9": {"__data__": {"id_": "e92897d1abc922dcc37ce355c9ee021a06b0fb3c15b50acb773ce866fa69d5c9", "embedding": null, "metadata": {"file_path": "app/auth.py", "doc_type": "code", "heading": "(\u6574\u6587\u4ef6)"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\"\"\"\u767b\u5f55\u4e0e\u9000\u51fa\u7684\u5165\u53e3\u3002\n\n\u672c\u6a21\u5757\u8d1f\u8d23\u4ee4\u724c\u7684\u751f\u547d\u5468\u671f\uff1a\u7b7e\u53d1\u3001\u6821\u9a8c\u3001\u7eed\u671f\u3001\u5931\u6548\u3002\n\u9000\u51fa\u767b\u5f55\u529f\u80fd\u5c1a\u672a\u5b9e\u73b0\uff0c\u89c1 logout() \u7684 TODO\u3002\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport secrets\nimport time\n\nfrom .session import SESSION_TTL_SECONDS, is_session_valid, refresh_expiry\n\n_TOKEN_STORE: dict[str, dict] = {}\n_SECRET = b\"login-demo-secret\"\n\ndef _sign(token: str) -> str:\n    \"\"\"\u7ed9\u4ee4\u724c\u505a\u4e00\u6b21 HMAC\uff0c\u9632\u6b62\u5ba2\u6237\u7aef\u4f2a\u9020\u3002\"\"\"\n    return hmac.new(_SECRET, token.encode(), hashlib.sha256).hexdigest()[:16]\n\ndef issue_token(user_id: str, now: int | None = None) -> str:\n    \"\"\"\u7b7e\u53d1\u4e00\u4e2a\u65b0\u7684\u4f1a\u8bdd\u4ee4\u724c\uff0c\u5e76\u628a\u5230\u671f\u65f6\u95f4\u5199\u8fdb\u5b58\u50a8\u3002\"\"\"\n    now = int(now if now is not None else time.time())\n    raw = f\"{user_id}.{now}.{secrets.token_hex(8)}\"\n    token = f\"{raw}.{_sign(raw)}\"\n    _TOKEN_STORE[token] = {\n        \"user_id\": user_id,\n        \"issued_at\": now,\n        \"expires_at\": refresh_expiry(now),\n    }\n    return token\n\ndef verify_token(token: str) -> bool:\n    \"\"\"\u6821\u9a8c\u7b7e\u540d\uff0c\u7b7e\u540d\u4e0d\u5bf9\u76f4\u63a5\u5224\u4e3a\u65e0\u6548\u3002\"\"\"\n    if token.count(\".\") != 3:\n        return False\n    raw, signature = token.rsplit(\".\", 1)\n    return hmac.compare_digest(_sign(raw), signature)\n\ndef check(token: str, now: int | None = None) -> bool:\n    \"\"\"\u6309\u4ee4\u724c\u67e5\u8be2\u4f1a\u8bdd\u662f\u5426\u6709\u6548\u3002\"\"\"\n    if not verify_token(token):\n        return False\n    record = _TOKEN_STORE.get(token)\n    if record is None:\n        return False\n    now = int(now if now is not None else time.time())\n    return is_session_valid(now, record[\"expires_at\"])\n\ndef expire_at(token: str) -> int | None:\n    \"\"\"\u8fd4\u56de\u4ee4\u724c\u7684\u5230\u671f\u65f6\u95f4\u6233\uff0c\u4ee4\u724c\u4e0d\u5b58\u5728\u65f6\u8fd4\u56de None\u3002\"\"\"\n    record = _TOKEN_STORE.get(token)\n    return record[\"expires_at\"] if record else None\n\ndef touch(token: str, now: int | None = None) -> int | None:\n    \"\"\"\u7528\u6237\u6709\u8bf7\u6c42\u65f6\u7eed\u671f\uff0c\u8fd4\u56de\u65b0\u7684\u5230\u671f\u65f6\u95f4\u3002\"\"\"\n    record = _TOKEN_STORE.get(token)\n    if record is None:\n        return None\n    now = int(now if now is not None else time.time())\n    if not is_session_valid(now, record[\"expires_at\"]):\n        return None\n    record[\"expires_at\"] = refresh_expiry(now)\n    return record[\"expires_at\"]\n\ndef purge_expired(now: int | None = None) -> int:\n    \"\"\"\u6e05\u7406\u5df2\u8fc7\u671f\u7684\u8bb0\u5f55\uff0c\u8fd4\u56de\u6e05\u7406\u6761\u6570\u3002\"\"\"\n    now = int(now if now is not None else time.time())\n    dead = [t for t, r in _TOKEN_STORE.items() if not is_session_valid(now, r[\"expires_at\"])]\n    for token in dead:\n        _TOKEN_STORE.pop(token, None)\n    return len(dead)\n\ndef logout(token: str) -> None:\n    \"\"\"\u9000\u51fa\u767b\u5f55\uff1a\u8ba9\u4ee4\u724c\u7acb\u5373\u5931\u6548\u3002\n\n    TODO: \u5c1a\u672a\u5b9e\u73b0\u3002\u9700\u8981\u5220\u9664 _TOKEN_STORE \u4e2d\u7684\u8bb0\u5f55\uff0c\n    \u5e76\u6309 docs/testing-guide.md \u8865\u4e00\u6761 test_logout_invalidates \u7528\u4f8b\u3002\n    \"\"\"\n    raise NotImplementedError(\"logout is not implemented yet\")", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "c781e8b2b305080eac140aaeb2dfef645e1229230e0c270f84e21c94fcb51718": {"__data__": {"id_": "c781e8b2b305080eac140aaeb2dfef645e1229230e0c270f84e21c94fcb51718", "embedding": null, "metadata": {"file_path": "app/config.py", "doc_type": "code", "heading": "(\u6574\u6587\u4ef6)"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\"\"\"\u9879\u76ee\u914d\u7f6e\u3002\n\n\u6ce8\u610f\uff1a\u8fd9\u91cc\u7684 SESSION_TTL_MINUTES \u662f\u8fd0\u7ef4\u8986\u76d6\u7528\u7684\uff0c\u9ed8\u8ba4\u503c\u4e3a\u7a7a\u3002\n\u771f\u6b63\u7684\u9ed8\u8ba4\u6709\u6548\u671f\u5e38\u91cf\u5728 app/session.py\u3002\n\"\"\"\n\nimport os\n\n# \u5141\u8bb8\u8fd0\u7ef4\u901a\u8fc7\u73af\u5883\u53d8\u91cf\u8986\u76d6\u767b\u5f55\u4f1a\u8bdd\u6709\u6548\u671f\uff08\u5206\u949f\uff09\u3002\nSESSION_TTL_MINUTES = os.environ.get(\"SESSION_TTL_MINUTES\", \"\")", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9b27c36dc485db95a3cd77ba73b20ee988055059864086e09bee940bef51913a": {"__data__": {"id_": "9b27c36dc485db95a3cd77ba73b20ee988055059864086e09bee940bef51913a", "embedding": null, "metadata": {"file_path": "app/session.py", "doc_type": "code", "heading": "(\u6574\u6587\u4ef6)"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\"\"\"\u767b\u5f55\u4f1a\u8bdd\u7684\u5224\u5b9a\u5b9e\u73b0\u3002\n\n\u672c\u6a21\u5757\u53ea\u8d1f\u8d23\"\u4ee4\u724c\u662f\u5426\u4ecd\u7136\u6709\u6548\"\u7684\u5224\u65ad\uff0c\u4e0d\u8d1f\u8d23\u7b7e\u53d1\u548c\u5b58\u50a8\u3002\n\"\"\"\n\nSESSION_TTL_SECONDS = 30 * 60  # \u767b\u5f55\u4f1a\u8bdd\u6709\u6548\u671f\uff0c\u5355\u4f4d\u79d2\n\ndef is_session_valid(now, expires_at):\n    \"\"\"\u5224\u65ad\u4f1a\u8bdd\u5728 now \u65f6\u523b\u662f\u5426\u6709\u6548\u3002\n\n    \u53c2\u6570\u90fd\u662f Unix \u65f6\u95f4\u6233\uff08\u79d2\uff09\u3002\n    \u5230\u671f\u65f6\u523b\u672c\u8eab\u89c6\u4e3a\u5df2\u8fc7\u671f\u3002\n    \"\"\"\n    return now < expires_at\n\ndef refresh_expiry(now):\n    \"\"\"\u8fd4\u56de\u7eed\u671f\u540e\u7684\u65b0\u5230\u671f\u65f6\u95f4\u3002\"\"\"\n    return now + SESSION_TTL_SECONDS", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "33f319fe3f0ce153ea430b9145954e0b59a51dd8e56ad748859a36e8154680e6": {"__data__": {"id_": "33f319fe3f0ce153ea430b9145954e0b59a51dd8e56ad748859a36e8154680e6", "embedding": null, "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "\u8ba4\u8bc1\u7ec4", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc", "heading": "\u5e38\u89c1\u95ee\u9898\uff08FAQ\uff09", "header_path": "/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/faq.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "\u8ba4\u8bc1\u7ec4", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc"}, "hash": "717885401c8e19783902874fb299635066a2ad898dec5727aba5afcbf2ed87d3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# \u5e38\u89c1\u95ee\u9898\uff08FAQ\uff09", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 11, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "e83fb880e2e96d5344ebc6012b0ae2b3dd26ad23f698dbc10145a45a1eea5b0