[{"id_": "e92897d1abc922dcc37ce355c9ee021a06b0fb3c15b50acb773ce866fa69d5c9", "embedding": null, "metadata": {"file_path": "app/auth.py", "doc_type": "code", "heading": "(整文件)"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\"\"\"登录与退出的入口。\n\n本模块负责令牌的生命周期：签发、校验、续期、失效。\n退出登录功能尚未实现，见 logout() 的 TODO。\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport hmac\nimport secrets\nimport time\n\nfrom .session import SESSION_TTL_SECONDS, is_session_valid, refresh_expiry\n\n_TOKEN_STORE: dict[str, dict] = {}\n_SECRET = b\"login-demo-secret\"\n\ndef _sign(token: str) -> str:\n    \"\"\"给令牌做一次 HMAC，防止客户端伪造。\"\"\"\n    return hmac.new(_SECRET, token.encode(), hashlib.sha256).hexdigest()[:16]\n\ndef issue_token(user_id: str, now: int | None = None) -> str:\n    \"\"\"签发一个新的会话令牌，并把到期时间写进存储。\"\"\"\n    now = int(now if now is not None else time.time())\n    raw = f\"{user_id}.{now}.{secrets.token_hex(8)}\"\n    token = f\"{raw}.{_sign(raw)}\"\n    _TOKEN_STORE[token] = {\n        \"user_id\": user_id,\n        \"issued_at\": now,\n        \"expires_at\": refresh_expiry(now),\n    }\n    return token\n\ndef verify_token(token: str) -> bool:\n    \"\"\"校验签名，签名不对直接判为无效。\"\"\"\n    if token.count(\".\") != 3:\n        return False\n    raw, signature = token.rsplit(\".\", 1)\n    return hmac.compare_digest(_sign(raw), signature)\n\ndef check(token: str, now: int | None = None) -> bool:\n    \"\"\"按令牌查询会话是否有效。\"\"\"\n    if not verify_token(token):\n        return False\n    record = _TOKEN_STORE.get(token)\n    if record is None:\n        return False\n    now = int(now if now is not None else time.time())\n    return is_session_valid(now, record[\"expires_at\"])\n\ndef expire_at(token: str) -> int | None:\n    \"\"\"返回令牌的到期时间戳，令牌不存在时返回 None。\"\"\"\n    record = _TOKEN_STORE.get(token)\n    return record[\"expires_at\"] if record else None\n\ndef touch(token: str, now: int | None = None) -> int | None:\n    \"\"\"用户有请求时续期，返回新的到期时间。\"\"\"\n    record = _TOKEN_STORE.get(token)\n    if record is None:\n        return None\n    now = int(now if now is not None else time.time())\n    if not is_session_valid(now, record[\"expires_at\"]):\n        return None\n    record[\"expires_at\"] = refresh_expiry(now)\n    return record[\"expires_at\"]\n\ndef purge_expired(now: int | None = None) -> int:\n    \"\"\"清理已过期的记录，返回清理条数。\"\"\"\n    now = int(now if now is not None else time.time())\n    dead = [t for t, r in _TOKEN_STORE.items() if not is_session_valid(now, r[\"expires_at\"])]\n    for token in dead:\n        _TOKEN_STORE.pop(token, None)\n    return len(dead)\n\ndef logout(token: str) -> None:\n    \"\"\"退出登录：让令牌立即失效。\n\n    TODO: 尚未实现。需要删除 _TOKEN_STORE 中的记录，\n    并按 docs/testing-guide.md 补一条 test_logout_invalidates 用例。\n    \"\"\"\n    raise NotImplementedError(\"logout is not implemented yet\")", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "c781e8b2b305080eac140aaeb2dfef645e1229230e0c270f84e21c94fcb51718", "embedding": null, "metadata": {"file_path": "app/config.py", "doc_type": "code", "heading": "(整文件)"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\"\"\"项目配置。\n\n注意：这里的 SESSION_TTL_MINUTES 是运维覆盖用的，默认值为空。\n真正的默认有效期常量在 app/session.py。\n\"\"\"\n\nimport os\n\n# 允许运维通过环境变量覆盖登录会话有效期（分钟）。\nSESSION_TTL_MINUTES = os.environ.get(\"SESSION_TTL_MINUTES\", \"\")", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "8d989e79a816349932cfad32b0982dcb70d091344d244f55f7b7193cb03416fd", "embedding": null, "metadata": {"file_path": "app/session.py", "doc_type": "code", "heading": "(整文件)"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\"\"\"登录会话的判定实现。\n\n本模块只负责\"令牌是否仍然有效\"的判断，不负责签发和存储。\n\"\"\"\n\nSESSION_TTL_SECONDS = 20 * 60  # 登录会话有效期，单位秒\n\ndef is_session_valid(now, expires_at):\n    \"\"\"判断会话在 now 时刻是否有效。\n\n    参数都是 Unix 时间戳（秒）。\n    到期时刻本身视为已过期。\n    \"\"\"\n    return now < expires_at\n\ndef refresh_expiry(now):\n    \"\"\"返回续期后的新到期时间。\"\"\"\n    return now + SESSION_TTL_SECONDS", "mimetype": "text/plain", "start_char_idx": null, "end_char_idx": null, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "33f319fe3f0ce153ea430b9145954e0b59a51dd8e56ad748859a36e8154680e6", "embedding": null, "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc", "heading": "常见问题（FAQ）", "header_path": "/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/faq.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc"}, "hash": "65630683b6c6336728ed910709ed8e15544f2292e4e4ad3bf066d849ef21d729", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# 常见问题（FAQ）", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 11, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "b5027f678ba24b252f15a2e49194bb58752de30ab605a970d2700045ec1f88d5", "embedding": null, "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc", "heading": "常见问题（FAQ） > 用户反馈\"登录状态老是掉\"", "header_path": "/常见问题（FAQ）/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/faq.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc"}, "hash": "65630683b6c6336728ed910709ed8e15544f2292e4e4ad3bf066d849ef21d729", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 用户反馈\"登录状态老是掉\"\n\n1. 先确认会话有效期配置是否被改过，默认 20 分钟。\n2. 再看是不是恰好卡在到期时刻被判定为无效，检查边界用例。\n3. 最后确认前端是否在响应里正确保存了新的令牌。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 103, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "5d9378d2004a069cf50dd2637e7ed300014954204d2284a0bb0beb9b1f1253f9", "embedding": null, "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc", "heading": "常见问题（FAQ） > 能否把有效期改长一点", "header_path": "/常见问题（FAQ）/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/faq.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc"}, "hash": "65630683b6c6336728ed910709ed8e15544f2292e4e4ad3bf066d849ef21d729", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 能否把有效期改长一点\n\n- 可以，但需要产品确认。修改前先读 `docs/session-rules.md`，不要直接改代码常量。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 68, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "5a13958fb29c2f60f86952011fa622aa641519efe57d155864207a3fecfef283", "embedding": null, "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc", "heading": "常见问题（FAQ） > 忘记测试命令怎么办", "header_path": "/常见问题（FAQ）/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/faq.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "troubleshooting", "owner": "认证组", "updated": "2026-09-25", "file_path": "docs/faq.md", "doc_type": "doc"}, "hash": "65630683b6c6336728ed910709ed8e15544f2292e4e4ad3bf066d849ef21d729", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 忘记测试命令怎么办\n\n- 见 `docs/testing-guide.md`，入口是 `python -m pytest tests/test_session.py -q`。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 90, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "b11a055cb1be5555fa23b4cbdc37f51914708096f561fae55c13b4add98aa3d5", "embedding": null, "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc", "heading": "支付会话规则", "header_path": "/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/payment-session.md", "node_type": "4", "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc"}, "hash": "40049497387f1106c86878a4d776b3fb7257eb64d1e5bdab83e04245cf789f29", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# 支付会话规则\n\n适用服务：pay_gateway 收单网关。本文与登录服务无关。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 42, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "ee3862125cb9413f8ccd51e13a5938d9e974dd58f09579cbd57e85f4ce9f69d3", "embedding": null, "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc", "heading": "支付会话规则 > 有效期长度", "header_path": "/支付会话规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/payment-session.md", "node_type": "4", "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc"}, "hash": "40049497387f1106c86878a4d776b3fb7257eb64d1e5bdab83e04245cf789f29", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 有效期长度\n\n- 支付会话有效期为 5 分钟。\n- 超时后订单进入 `PAY_TIMEOUT` 状态，需要用户重新下单。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 63, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "c5636e0f5e1517b88429fb98ab2420d76afc4e211fffffe9d344e76674884f67", "embedding": null, "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc", "heading": "支付会话规则 > 到期边界", "header_path": "/支付会话规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/payment-session.md", "node_type": "4", "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc"}, "hash": "40049497387f1106c86878a4d776b3fb7257eb64d1e5bdab83e04245cf789f29", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 到期边界\n\n- 支付会话在 `now >= expires_at` 时置为超时。\n- 与登录会话不同，支付会话到期后不刷新，只能重建。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 70, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "2a662f1f9202a7e8bdab60d632d5285a97baf37e6c139c073500d48999ed5420", "embedding": null, "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc", "heading": "支付会话规则 > 与登录会话的区别", "header_path": "/支付会话规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/payment-session.md", "node_type": "4", "metadata": {"service": "pay_gateway", "topic": "session-expiry", "owner": "支付组", "updated": "2026-08-15", "file_path": "docs/payment-session.md", "doc_type": "doc"}, "hash": "40049497387f1106c86878a4d776b3fb7257eb64d1e5bdab83e04245cf789f29", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 与登录会话的区别\n\n- 登录会话 20 分钟、可续期；支付会话 5 分钟、不可续期。\n- 两者共用 `expires_at` 字段名，排查问题时先确认是哪个服务的会话。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 87, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "b59f65bf6366382b02f7fbd3fba4b1f5aa95f593d1b8d361216148057ca92d2f", "embedding": null, "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc", "heading": "登录会话有效期规则", "header_path": "/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/session-rules.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc"}, "hash": "a37ef9b87465c321245be3a9084616a266795dba665eb515ae5b1e61653679a3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# 登录会话有效期规则\n\n适用服务：login_demo 登录服务。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 34, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "92389e6428bdc1d34e5c8e5ba1692df841a7c79f8b7a9ec5dcddbdff1c3daeff", "embedding": null, "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc", "heading": "登录会话有效期规则 > 有效期长度", "header_path": "/登录会话有效期规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/session-rules.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc"}, "hash": "a37ef9b87465c321245be3a9084616a266795dba665eb515ae5b1e61653679a3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 有效期长度\n\n- 管理后台的登录会话有效期为 20 分钟。\n- 计时方式：从签发时刻开始计算，20 分钟后到期。\n- 空闲会话不自动续期，必须由用户请求触发刷新。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 84, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "8da2ad66986b25e78890b5d2da8671f8a1b644c1eed2710e7aaf61ec2b60e2a4", "embedding": null, "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc", "heading": "登录会话有效期规则 > 到期边界", "header_path": "/登录会话有效期规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/session-rules.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc"}, "hash": "a37ef9b87465c321245be3a9084616a266795dba665eb515ae5b1e61653679a3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 到期边界\n\n- 项目约定：当前时刻恰好等于到期时刻时，会话必须判定为无效。\n- 也就是说，`now == expires_at` 属于已过期。\n- 实现上有效条件写作 `now < expires_at`，不要写成 `now <= expires_at`。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 131, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "68d2b7a4f81d6968ae1198545dab8bed35f9bd26b08dc586877f6ce16d388522", "embedding": null, "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc", "heading": "登录会话有效期规则 > 续期", "header_path": "/登录会话有效期规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/session-rules.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc"}, "hash": "a37ef9b87465c321245be3a9084616a266795dba665eb515ae5b1e61653679a3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 续期\n\n- 用户发起请求后，服务在响应返回前刷新 `expires_at`。\n- 新的到期时间 = 请求到达时刻 + 20 分钟。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 68, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "555756da73138feee68f7571d60485eb44d155ca3468ae5cbec403c18e12dd2b", "embedding": null, "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc", "heading": "登录会话有效期规则 > 不适用范围", "header_path": "/登录会话有效期规则/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/session-rules.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "session-expiry", "owner": "认证组", "updated": "2026-10-01", "file_path": "docs/session-rules.md", "doc_type": "doc"}, "hash": "a37ef9b87465c321245be3a9084616a266795dba665eb515ae5b1e61653679a3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 不适用范围\n\n- 本节规则只约束登录会话，不适用于支付会话、匿名浏览会话。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 40, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "74131b12c647d32bdedfd491afe43176a621086f6ce60053a82b21c12c8b8543", "embedding": null, "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc", "heading": "login_demo 测试指南", "header_path": "/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/testing-guide.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc"}, "hash": "5f87ecc1982998096d0d9bf53d3201bfdd6045cca4426ec7e767c6113002b38b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# login_demo 测试指南", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 17, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "85c82f39d5638eb33ba4f8e2ddd18804aa4095602a23b327f98c62a38ada39cb", "embedding": null, "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc", "heading": "login_demo 测试指南 > 测试入口", "header_path": "/login_demo 测试指南/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/testing-guide.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc"}, "hash": "5f87ecc1982998096d0d9bf53d3201bfdd6045cca4426ec7e767c6113002b38b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 测试入口\n\n- 统一入口：`python -m pytest tests/test_session.py -q`\n- 不要直接敲 `pytest tests/test_session.py`，项目的 CI 只认 `python -m pytest` 形式。\n- 运行前先激活虚拟环境：`source .venv/bin/activate`。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 173, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "0a4182bdddffa7c5d8ef5713845788a215009b51c6af1c66e719ba6021ef6750", "embedding": null, "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc", "heading": "login_demo 测试指南 > 关键用例", "header_path": "/login_demo 测试指南/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/testing-guide.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc"}, "hash": "5f87ecc1982998096d0d9bf53d3201bfdd6045cca4426ec7e767c6113002b38b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 关键用例\n\n- `test_expire_boundary`：覆盖 `now == expires_at`，期望返回 `False`。\n- `test_refresh_extends_ttl`：覆盖续期后到期时间被推后 20 分钟。\n- `test_logout_invalidates`：退出登录后，同一个会话令牌应判定为无效。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 168, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "404cce9ab269a7c66ae150b8f72636241c1bf427c843c98476fbc3d16371e4d2", "embedding": null, "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc", "heading": "login_demo 测试指南 > 提交前检查", "header_path": "/login_demo 测试指南/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "docs/testing-guide.md", "node_type": "4", "metadata": {"service": "login_demo", "topic": "testing", "owner": "认证组", "updated": "2026-09-20", "file_path": "docs/testing-guide.md", "doc_type": "doc"}, "hash": "5f87ecc1982998096d0d9bf53d3201bfdd6045cca4426ec7e767c6113002b38b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 提交前检查\n\n- 单元测试必须全绿。\n- 不要为了通过测试去修改测试文件，测试文件由维护者负责。\n- 新增功能要补一条对应用例，并在提交说明里写清用例名。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 80, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, {"id_": "a4f96c46541f351860e4167e0504c8f926fc3da5e57ae238671aceee4fd70e59", "embedding": null, "metadata": {"file_path": "tables/session-matrix.csv", "doc_type": "table", "heading": "", "header_path": "/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "tables/session-matrix.csv", "node_type": "4", "metadata": {"file_path": "tables/session-matrix.csv", "doc_type": "table"}, "hash": "2d694a3d770875c405fb2729ef747ca723ed6a3f9a7363ba1257de3cfa16d50b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "服务是login_demo；会话类型是登录会话；有效期是20 分钟；可续期是是；到期边界处理是恰好到期视为无效；负责人是认证组。\n服务是pay_gateway；会话类型是支付会话；有效期是5 分钟；可续期是否；到期边界处理是到期即置为超时；负责人是支付组。\n服务是login_demo；会话类型是匿名浏览会话；有效期是120 分钟；可续期是是；到期边界处理是到期后重新签发；负责人是认证组。\n服务是login_demo；会话类型是记住我令牌；有效期是30 天；可续期是是；到期边界处理是到期需重新登录；负责人是认证组。", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 259, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}]