+  if (Number.isNaN(expiresAtMs)) {
+    // 无法解析的过期时间一律视为已过期（fail-closed）。
+    return true;
+  }
+
+  const nowMs = now instanceof Date ? now.getTime() : Number(now);
+
+  if (Number.isNaN(nowMs)) {
